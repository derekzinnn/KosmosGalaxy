# ══════════════════════════════════════════════════════════════════════════
#  Kosmos Galaxy — API environment
#  Copy this file to .env and fill it in. Never commit .env.
# ══════════════════════════════════════════════════════════════════════════

# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on.
PORT=3333

# PostgreSQL connection string (Supabase, Sao Paulo region).
# Prisma 7 reads this through prisma.config.ts, not through schema.prisma.
DATABASE_URL="postgresql://user:password@host:5432/kosmos?schema=public"

# Database used by `npm test`. It is migrated and TRUNCATED between tests,
# so it must never point at development or production data.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/kosmos_test?schema=public"

# Shadow database used by `prisma migrate dev` to detect schema drift.
# Optional locally. Required on hosted Postgres where Prisma is not allowed
# to create throwaway databases itself.
# SHADOW_DATABASE_URL="postgresql://user:password@host:5432/kosmos_shadow"

# Secret used to sign access-token JWTs. Minimum 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-at-least-32-random-characters-please"

# Access token lifetime in seconds. 900 = 15 minutes.
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in seconds. 2592000 = 30 days.
REFRESH_TOKEN_TTL_SECONDS=2592000

# Invitation lifetime in seconds. 604800 = 7 days.
INVITATION_TTL_SECONDS=604800

# Password reset token lifetime in seconds. 3600 = 1 hour.
PASSWORD_RESET_TTL_SECONDS=3600

# Public origin of the web app. Used as the allowed CORS origin and to build
# the links inside invitation and password-reset emails.
WEB_APP_URL="http://localhost:5173"

# Cookie domain for the refresh token cookie. Leave empty in development.
# In production this must be a domain shared by web and API, e.g.
# ".kosmosgalaxy.com.br" — otherwise SameSite=Lax drops the cookie and every
# refresh silently fails. See "Infra requirements" in CLAUDE.md.
COOKIE_DOMAIN=

# Number of reverse proxies in front of the API (Caddy = 1, direct = 0).
# If this is wrong every request appears to come from the proxy: rate limits
# collapse into one shared bucket and audit rows record a useless IP.
TRUST_PROXY=0

# Email delivery. Phase 0 ships only "console", which prints the message and
# its raw link to stdout. A real provider is chosen in a later phase.
EMAIL_PROVIDER=console
EMAIL_FROM="Kosmos Galaxy <nao-responda@kosmosgalaxy.com.br>"

# ── Video (Phase 2) ───────────────────────────────────────────────────────
# "fake" mints a signed URL that plays nothing — enough to develop and test
# the assignment check, the unlock rule and the expiry without a vendor
# account. The API refuses to boot in production while set to fake.
VIDEO_PROVIDER=fake

# Panda Video credentials. All four are required when VIDEO_PROVIDER=panda.
#
#   API_KEY        Dashboard - Configuracoes - Avancado - Gerar nova chave API
#   LIBRARY_ID     The pullzone name, "vz-...". Also readable from GET /library
#   WATERMARK_*    A watermark group, created separately from the API key. Its
#                  secret signs the JWT that burns the viewer's identity into
#                  playback -- the feature Panda was chosen for.
#
# PANDA_API_KEY=
# PANDA_LIBRARY_ID=
# PANDA_WATERMARK_GROUP_ID=
# PANDA_WATERMARK_SECRET=

# How long a minted playback URL stays valid. 600 = 10 minutes. Long enough
# to start a lesson on a slow connection, short enough that a URL pasted into
# a group chat is dead before anyone opens it.
PLAYBACK_URL_TTL_SECONDS=600

# How often the player reports its position while a lesson plays.
HEARTBEAT_INTERVAL_SECONDS=15

# Fraction of a lesson that must be watched before it counts as complete.
# Measured against watched time, not the furthest point reached — dragging
# the scrubber to the end moves the second and not the first.
LESSON_COMPLETION_RATIO=0.9

# Fastest playback credited as real watching, as a multiple of wall-clock
# time. Above 1 so people watching at 1.5x or 2x still finish the lesson;
# bounded so that jumping to the end credits nothing.
MAX_CREDITED_PLAYBACK_SPEED=3

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Seeding (optional) ────────────────────────────────────────────────────
# Used only by `npm run db:seed`, which creates the first Kosmos staff
# account. Nothing else can exist until this one does — there would be nobody
# to send the first invitation.
SEED_ADMIN_EMAIL="admin@kosmos.com.br"
SEED_ADMIN_NAME="Kosmos Admin"
SEED_ADMIN_PASSWORD=
