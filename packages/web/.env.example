# ══════════════════════════════════════════════════════════════════════════
#  Kosmos Galaxy — Web environment
#  Copy this file to .env. Only VITE_-prefixed variables reach the browser,
#  and everything here is public: never put a secret in this file.
# ══════════════════════════════════════════════════════════════════════════

# Base URL of the Kosmos Galaxy API.
# Must share a registrable domain with the web app in production, or the
# browser will drop the SameSite=Lax refresh cookie and every silent refresh
# will fail. See "Infra requirements" in CLAUDE.md.
VITE_API_URL="http://localhost:3333"
